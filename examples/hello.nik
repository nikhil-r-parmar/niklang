
# =====================================
# NIKLANG - Official Demo Program
# =====================================

bol "Welcome to NIKLANG!"
bol "Custom Hinglish Programming Language"
bol " "

# 1. Variables and strings

maanlo name = "Nikhil"
maanlo age = 18

bol "1. Variables and Strings"
bol "Name: " + name
bol "Age: " + age

# 2. Arithmetic operations

maanlo a = 10
maanlo b = 20
maanlo total = a + b

bol " "
bol "2. Arithmetic Operations"
bol "First Number: " + a
bol "Second Number: " + b
bol "Addition: " + total

maanlo next = total / 2
bol "Division: " + next

# 3. Conditional statements

bol " "
bol "3. Conditional Statements"

maanlo marks = 85

agar marks >= 35 {
    bol "Result: PASS"
} warna {
    bol "Result: FAIL"
}

agar marks >= 80 {
    bol "Grade: Excellent"
} warna {
    bol "Grade: Needs Improvement"
}

# 4. While loop

bol " "
bol "4. While Loop"

maanlo count = 1

jab tak count <= 5 {
    bol "Count: " + count
    maanlo count = count + 1
}

# 5. Countdown

bol " "
bol "5. Countdown"

maanlo number = 5

jab tak number > 0 {
    bol "Number: " + number
    maanlo number = number - 1
}

bol "Countdown completed!"

# 6. String concatenation

bol " "
bol "6. String Concatenation"

maanlo first = "Hello"
maanlo second = "Nikhil"

bol first + second
bol "Hello " + second

maanlo surname = "Parmar"
bol name + surname

# 7. Comparison operators

bol " "
bol "7. Comparison Operators"

agar 10 > 5 {
    bol "Greater than works"
}

agar 10 == 10 {
    bol "Equal comparison works"
}

agar 10 != 20 {
    bol "Not equal comparison works"
}

agar 10 <= 10 {
    bol "Less than or equal works"
}

agar 10 >= 10 {
    bol "Greater than or equal works"
}

# =====================================
# END OF NIKLANG DEMO
# =====================================

bol " "
bol "NIKLANG DEMO COMPLETED!"
