include "nicky_p"

maanlo name = puch("Tera name kya hai? : ")
maanlo score = 75
maanlo backup = score
maanlo discount = 25
maanlo saved = discount
maanlo total = score - discount

bol "Welcome to NIKLANG!, " + name
bol "Your score: " + total

agar score >= 90 {
    bol "Full Aura!"
} warna {
    bol "Grind mode!"
}

kyu score
kyu (score >= 90)